# The scratch copies' known starting point (SKILL.md, "A baseline"). Change a line here, then `bin/copies.sh build`
# builds it again. A batch's own lines go in the state folder's batch.env, which copies.sh reads after this file.

FACTORY_REAL=the-roganator/cv-software-factory
APP_REAL=the-roganator/cv-worlds-worst-website
FACTORY_COPY=the-roganator/cv-software-factory-scratch
APP_COPY=the-roganator/cv-worlds-worst-website-scratch

# The real main each baseline starts from.
FACTORY_FROM=7ee046d0a352388305fe1f9418a7ab93524571e7
APP_FROM=9604b5ff69f511e7ee2f793fd086aea3f6b57e35

# Merged moves put back, newest first, so the baseline holds the vulnerable pin (TESTS.md).
#   766d8d0d  hono 4.13.18  -> back to 4.13.12             test 7a  (#1073)
#   f57d2662  playwright v1.65.0-noble, its older digest    test 6   (#1035; its library is still 1.65.0 on main)
#   396afeaf  postgres 18.7 -> back to 18.6-alpine3.24      test 1   (#1137)
#   2eade6f1  loki 21.2.3   -> back to 18.13.7              test 4   (#1127)
#   29062432  opentelemetry-collector 0.178.3 -> 0.174.0    test 3   (#1142)
#   9000e933  prometheus 29.47.2 -> 29.35.0                 test 2   (#1135)
#   7ec8609f  grafana 14.4.1 -> 13.2.7                      test 4   (#1132)
#   af604416  kyverno reports-controller v1.20.0 -> v1.19.1 test 5   (#1131)
#   db1bdb85  kyverno kyvernopre v1.20.0 -> v1.19.1         test 5   (#1130)
#   9ede6d91  kyverno v1.20.0 -> v1.19.1                    test 5   (#1129)
#   8d0431fe  kyverno readiness-checker v1.20.0 -> v1.19.1  test 5   (#1128)
FACTORY_REVERTS="766d8d0d f57d2662 29062432 9000e933 7ec8609f af604416 db1bdb85 9ede6d91 8d0431fe 2eade6f1 396afeaf"
#   8089f77   syft v1.57.1  -> back to v1.54.0              test 12  (app #43)
#   e4dc88c   protobufjs    -> back                         test 8   (app #55)
#   91cd774   @grpc/grpc-js 1.14.7 -> back to 1.14.5        test 8   (app #53)
APP_REVERTS="8089f77 e4dc88c 91cd774"
# The Dependabot pull requests the tests need, kept open at each reset; every other is closed (a regex over the
# lowercased title): Playwright's image and library (test 6), Syft (test 12) and the app's Node image (N1).
DEPENDABOT_KEEP_FACTORY='^$'
DEPENDABOT_KEEP_APP='anchore/syft|bump node from'

# A small run's PIN_WATCH_ONLY (the moves the scratch pin watch takes, by the names moves.json gives, comma-separated;
# `*` or unset, every move) and a baseline's STAGED_EXTRA (staged/<side>-<extra>/) are set in batch.env, not here:
# `node bin/harness.ts only <tests>` prints the line for a set of tests. Either is part of the baseline.
