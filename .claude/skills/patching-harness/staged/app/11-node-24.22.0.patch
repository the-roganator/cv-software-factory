# Tests 10 and 11, Node's own advisory: Node back to 24.22.0 (its advisories are patched in 24.22.1) in mise.toml, mise.lock, the build stage's image and the distroless runtime's digest, which the gates hold to one Node.
diff --git a/Dockerfile b/Dockerfile
index c1022cc..3c3c0a9 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -2,7 +2,7 @@
 #
 #     docker build --build-arg GIT_COMMIT=$(git rev-parse HEAD) .
 
-FROM node:24.22.3-alpine3.24@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS build
+FROM node:24.22.0-alpine3.24@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS build
 WORKDIR /app
 # pnpm at the version (and hash) pinned in package.json's packageManager field.
 RUN corepack enable
@@ -17,7 +17,7 @@ RUN node scripts/seed.ts
 # Readable by the unprivileged runtime user, and by nobody's writes.
 RUN chmod -R a+rX,go-w /app
 
-FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:6abfcb367ebc291572c774c1592a986be2ab26a2486f73093401327495a5962a
