# Test 20: the factory's workflows as a Dependabot group of their own, outside the cooldown, so one pull request moves the app's six pins of them to the factory's main
diff --git a/.github/dependabot.yml b/.github/dependabot.yml
--- a/.github/dependabot.yml
+++ b/.github/dependabot.yml
@@ -33,11 +33,19 @@
       interval: weekly
     cooldown:
       default-days: 3
+      # Software Factory's workflows are called at a commit of its main, which is minutes old when it should be taken:
+      # the factory's own gates are what it waited for.
+      exclude: ['the-roganator/cv-software-factory/*']
     commit-message:
       prefix: ci
     groups:
+      # Software Factory's workflows, which move together to one commit of its main: a pull request of their own, apart
+      # from every other action's.
+      factory:
+        patterns: ['the-roganator/cv-software-factory/*']
       actions:
         patterns: ['*']
+        exclude-patterns: ['the-roganator/cv-software-factory/*']
 
   - package-ecosystem: docker
     directories:
