# Test 28 and every test that stands on an image's or a chart's fix: a reset deletes the scan's state, so the content of every fix is first seen at the next scan and waits a day. With the repository variable SCRATCH_CONTENT_SEEN_DAYS_AGO set, the scan writes each such sighting in its state as that many days old, so the scan after it lists the moves, and the waits in that run's moves.json moved back the same; unset, the step does not run. The step holds the scan's key, to seal the state again, so the workflows' test of which steps hold it names this one.
diff --git a/.github/workflows/vulnerabilities.yml b/.github/workflows/vulnerabilities.yml
index cbfc9071..f1d3bd70 100644
--- a/.github/workflows/vulnerabilities.yml
+++ b/.github/workflows/vulnerabilities.yml
@@ -335,6 +335,61 @@ jobs:
         with:
           path: ${{ runner.temp }}/lookups/deadlines.json
           key: vulnerabilities-lookups-${{ steps.day.outputs.day }}
+      # The scratch copies alone, for the patching tests: with the repository variable SCRATCH_CONTENT_SEEN_DAYS_AGO set
+      # (a whole number of days), each fix's content the state has seen for less than that long is written as first
+      # seen that many days ago, and the state sealed again for this run; a pin of this run's moves.json that waits for
+      # that content's day is moved back the same, before either is uploaded, so the two agree as the GitHub worker
+      # holds them to. A reset of a copy deletes its scan's state, so every image's digest and chart's version is first
+      # seen at the next scan and waits its day; the scan after it reads this state and lists them, and the tests read
+      # both. With the variable unset, as at every other time, the step does not run.
+      - name: Put the state’s sightings back for the patching tests
+        if: ${{ steps.scan.outputs.sarif == 'true' && vars.SCRATCH_CONTENT_SEEN_DAYS_AGO != '' }}
+        env:
+          SCAN_STATE_KEY: ${{ secrets.SCAN_STATE_KEY }}
+          DAYS: ${{ vars.SCRATCH_CONTENT_SEEN_DAYS_AGO }}
+        run: |
+          node --input-type=module - "$RUNNER_TEMP/scan/state.sealed" "$RUNNER_TEMP/scan/moves.json" <<'JS'
+          import { readFileSync, writeFileSync } from 'node:fs';
+          import { resolve } from 'node:path';
+          import { pathToFileURL } from 'node:url';
+          const state = resolve('factory/apps/factory/src/vulnerabilities/state.ts');
+          const { open, seal, readKey } = await import(pathToFileURL(state).href);
+          const file = process.argv[2];
+          const days = Number(process.env.DAYS);
+          if (!Number.isInteger(days) || days < 1 || days > 30)
+            throw new Error('SCRATCH_CONTENT_SEEN_DAYS_AGO is a whole number of days, 1 to 30');
+          const key = readKey(process.env.SCAN_STATE_KEY ?? '');
+          const kept = open(readFileSync(file), key, process.env.GITHUB_REPOSITORY, process.env.GITHUB_RUN_ID);
+          const span = days * 86_400_000;
+          const back = (day) => new Date(Date.parse(day) - span).toISOString().replace(/\.\d+Z$/, 'Z');
+          let put = 0;
+          // Each day moved back, by what it was: a pin of moves.json that waits until it is moved back the same.
+          const moved = new Map();
+          // A fix's content, on its pin: when it was first seen, and the day it is installable, where that came after.
+          for (const finding of kept.findings) {
+            for (const wait of finding.waits ?? []) {
+              if (Date.now() - Date.parse(wait.seen) >= span) continue;
+              if (Date.parse(wait.day) > Date.parse(wait.seen)) {
+                moved.set(Date.parse(wait.day), back(wait.day));
+                wait.day = back(wait.day);
+              }
+              wait.seen = back(wait.seen);
+              put += 1;
+            }
+          }
+          writeFileSync(file, seal(kept, key));
+          const movesFile = process.argv[3];
+          const moves = JSON.parse(readFileSync(movesFile, 'utf8'));
+          let until = 0;
+          for (const each of moves.waiting ?? []) {
+            const to = each.why === 'content' && !each.routine ? moved.get(Date.parse(each.until ?? '')) : undefined;
+            if (to === undefined) continue;
+            each.until = to;
+            until += 1;
+          }
+          writeFileSync(movesFile, `${JSON.stringify(moves, null, 2)}\n`);
+          console.log(`Put ${put} sightings ${days} days back in the state, and ${until} waits in moves.json, for the patching tests.`);
+          JS
       # The moves, as the log printed them: what the GitHub worker reads, from the default branch's last finished run.
       - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
         timeout-minutes: 5
