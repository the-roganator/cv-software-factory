{
  "name": "@software-factory/console",
  "version": "0.0.0",
  "private": true,
  "description": "The factory's web UI: a single-page app written in React and run by Preact, built by Vite, and the Node server that relays the event store to it.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "start": "node --import ./src/telemetry.ts src/server.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.37.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@software-factory/events": "workspace:*",
    "@software-factory/store": "workspace:*",
    "pino": "^10.4.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@prefresh/core": "^1.5.11",
    "@prefresh/utils": "^1.2.1",
    "@prefresh/vite": "^4.0.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@software-factory/factory": "workspace:*",
    "@software-factory/policy": "workspace:*",
    "@software-factory/testing": "workspace:*",
    "preact": "^11.0.2",
    "vite": "^8.3.5"
  }
}
