# The factory's browser image: the probes and the crawler (`factory probes run`, `factory crawler run`). The same code
# as Dockerfile, on the pinned Playwright image, which carries Chromium and the system libraries it needs. Built
# from the repository root:
#
#     docker build --file apps/factory/Dockerfile.browser .
#
# The Playwright package in the lockfile and the browsers in the image must be the same release. This is the image's
# one pin: the Makefile and the pull request checks run their browser tests in it too. Dependabot moves it and the
# package in one pull request, and scripts/image-pins.test.ts fails while they disagree.
#
# Playwright's image carries a Node of its own, which its tag does not name and which moves to Node's next major
# when Playwright's does (1.65 moved it from 24 to 26, with no corepack). The probes run on the repository's Node
# instead, mise.toml's, from the Node image pinned below, which scripts/image-pins.test.ts holds to mise.toml as it
# does every other image's: the image's own Node is taken out, so there is one.
#
# It runs as an unprivileged user, never root. Chromium cannot use its own sandbox without privileges that the
# restricted Pod Security Standard refuses, so Playwright starts it with the sandbox off (its default), and the pod's
# fences carry that instead: a non-root user, no capabilities, a read-only filesystem and a network policy that
# lets it reach only the app and Postgres.

# The Node, with its corepack, that the Playwright image's own is replaced with: the runner's, on Debian, whose
# glibc build runs on the Playwright image's Ubuntu.
FROM node:24.22.1-trixie-slim@sha256:43b9ba1142b8dcf33fa8f922ca1be85714adc444e0586c7cf7726daaeabc1bea AS node

FROM mcr.microsoft.com/playwright:v1.65.0-noble@sha256:6e3fb709361521eb27161606e6da6d2674e5e89fa16516cb37d6fdd91372273d AS browsers

# Playwright's browsers on mise.toml's Node. `make e2e` runs the browser tests in this stage too. The image's Node is
# its Debian package, and npm's global packages (npm itself and yarn) beside it; dpkg takes the package out with no
# network.
FROM browsers AS playwright
RUN dpkg --purge nodejs && rm -rf /usr/lib/node_modules /usr/bin/npm /usr/bin/npx /usr/bin/yarn /usr/bin/yarnpkg
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/corepack /usr/local/lib/node_modules/corepack
RUN ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack

# The production dependencies, readable by the unprivileged runtime user and writable by root alone, set in the layer
# that installs them, so a change to the code alone writes none of them again.
FROM playwright AS deps
WORKDIR /repo
# pnpm at the version (and hash) pinned in package.json's packageManager field.
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/factory/package.json apps/factory/
COPY packages/events/package.json packages/events/
COPY packages/store/package.json packages/store/
COPY packages/triage/package.json packages/triage/
# No lifecycle scripts: the only one is the repository's own, which installs git hooks. The browsers come with the image.
RUN pnpm install --frozen-lockfile --ignore-scripts --prod --filter @software-factory/factory... \
  && chmod -R a+rX,go-w /repo

# The dependencies first, then the code over them, each copy a layer of its own, the code with the same modes.
FROM playwright AS runtime
COPY --from=deps /repo /repo
WORKDIR /repo
COPY --chmod=a+rX,go-w apps/factory/src apps/factory/src
COPY --chmod=a+rX,go-w packages/events/src packages/events/src
COPY --chmod=a+rX,go-w packages/store/src packages/store/src
COPY --chmod=a+rX,go-w packages/triage/src packages/triage/src
COPY --chmod=a+rX,go-w policy policy
WORKDIR /repo/apps/factory
# The same user as the factory image, so the artifacts volume looks the same to every worker that writes to it. Its
# home is a folder the pod makes writable; the root filesystem is read-only.
USER 65532:65532
ENV HOME=/tmp NODE_ENV=production PORT=8080
EXPOSE 8080
# As the factory image: Node is the entrypoint, and a Deployment names the command.
ENTRYPOINT ["node"]
CMD ["src/cli.ts"]
