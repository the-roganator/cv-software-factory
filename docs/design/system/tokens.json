{
  "$description": "Software Factory design tokens, Paper & Ink. Source of truth: tokens.css and properties.css are generated from this file by build.ts. Format follows the W3C Design Tokens (DTCG) draft: every token has $type and $value. Colour lives under theme.<name> so both themes share one set of role names.",

  "theme": {
    "paper": {
      "$description": "Default. Ivory paper, graphite ink, one ember.",
      "bg":           { "$type": "color", "$value": "#f4f1ea", "$description": "Page ground." },
      "surface":      { "$type": "color", "$value": "#ebe6dd", "$description": "Panels, belt, sunken areas." },
      "raised":       { "$type": "color", "$value": "#fbfaf7", "$description": "Cards and popovers above the ground; station chassis." },
      "line":         { "$type": "color", "$value": "#ddd6ca", "$description": "Hairline dividers and borders." },
      "line-strong":  { "$type": "color", "$value": "#c9c1b3", "$description": "Control borders, emphasised dividers." },
      "text":         { "$type": "color", "$value": "#202020", "$description": "Body text and illustration ink." },
      "text-2":       { "$type": "color", "$value": "#4d4d4d", "$description": "Secondary text." },
      "text-muted":   { "$type": "color", "$value": "#615c56", "$description": "Labels and captions. Lowest colour allowed for meaningful text." },
      "text-faint":   { "$type": "color", "$value": "#a8a095", "$description": "Decoration only: disabled, idle, baselines. Never for text that must be read." },
      "on-inverse":   { "$type": "color", "$value": "#f4f1ea", "$description": "Text on a text-coloured fill." },
      "scrim":        { "$type": "color", "$value": "#2a26214d", "$description": "Dims the page behind the sheet. Never carries meaning." },
      "signal":       { "$type": "color", "$value": "#2a2826", "$description": "Work in flight and primary actions. Things moving is not news, so it is neutral ink." },
      "signal-hover": { "$type": "color", "$value": "#000000" },
      "on-signal":    { "$type": "color", "$value": "#f4f1ea" },
      "signal-wash":  { "$type": "color", "$value": "#fffdf8" },
      "signal-line":  { "$type": "color", "$value": "#b8b0a3" },
      "ok":           { "$type": "color", "$value": "#3b6631", "$description": "Healthy, passed, verified." },
      "on-ok":        { "$type": "color", "$value": "#ffffff" },
      "ok-wash":      { "$type": "color", "$value": "#e3ecdc" },
      "ok-line":      { "$type": "color", "$value": "#b5cba9" },
      "ok-text":      { "$type": "color", "$value": "#2f5427" },
      "attn":         { "$type": "color", "$value": "#b53c0a", "$description": "The one warm colour: a human should look. Needs you, held, blocked, failed, rolled back, Stop the line." },
      "on-attn":      { "$type": "color", "$value": "#ffffff" },
      "attn-wash":    { "$type": "color", "$value": "#f8e3d6" },
      "attn-line":    { "$type": "color", "$value": "#e9b89c" },
      "station-face": { "$type": "color", "$value": "#252321", "$description": "Station LED face. Always dark, in both themes: each station carries a small piece of the Ink theme." },
      "station-led-dim":  { "$type": "color", "$value": "#77716a", "$description": "LED glyphs when idle." },
      "station-led-on":   { "$type": "color", "$value": "#f4f1ea", "$description": "LED glyphs when working or sending back." },
      "station-led-ok":   { "$type": "color", "$value": "#a9c79c", "$description": "LED glyphs when passing." },
      "station-led-attn": { "$type": "color", "$value": "#f09a64", "$description": "LED glyphs when blocked or failed." },
      "station-canary":   { "$type": "color", "$value": "#e9c46a", "$description": "The Release station's canary. The only colour with no meaning: it is yellow because it is a canary." }
    },
    "ink": {
      "$description": "Warm near-black, softened so light text doesn't bloom against the ground.",
      "bg":           { "$type": "color", "$value": "#161514" },
      "surface":      { "$type": "color", "$value": "#1b1a18" },
      "raised":       { "$type": "color", "$value": "#211f1d" },
      "line":         { "$type": "color", "$value": "#2c2a27" },
      "line-strong":  { "$type": "color", "$value": "#403d39" },
      "text":         { "$type": "color", "$value": "#e2ddd5" },
      "text-2":       { "$type": "color", "$value": "#b3ada5" },
      "text-muted":   { "$type": "color", "$value": "#8f8982" },
      "text-faint":   { "$type": "color", "$value": "#5a5650" },
      "on-inverse":   { "$type": "color", "$value": "#161514" },
      "scrim":        { "$type": "color", "$value": "#000000a3" },
      "signal":       { "$type": "color", "$value": "#e2ddd5" },
      "signal-hover": { "$type": "color", "$value": "#ffffff" },
      "on-signal":    { "$type": "color", "$value": "#161514" },
      "signal-wash":  { "$type": "color", "$value": "#24211e" },
      "signal-line":  { "$type": "color", "$value": "#4a4640" },
      "ok":           { "$type": "color", "$value": "#9dbb91" },
      "on-ok":        { "$type": "color", "$value": "#12190f" },
      "ok-wash":      { "$type": "color", "$value": "#1a2118" },
      "ok-line":      { "$type": "color", "$value": "#354531" },
      "ok-text":      { "$type": "color", "$value": "#bcd3b2" },
      "attn":         { "$type": "color", "$value": "#d9824f" },
      "on-attn":      { "$type": "color", "$value": "#161514" },
      "attn-wash":    { "$type": "color", "$value": "#2a1d16" },
      "attn-line":    { "$type": "color", "$value": "#5e3a26" },
      "station-face": { "$type": "color", "$value": "#0e0d0c" },
      "station-led-dim":  { "$type": "color", "$value": "#6a655e" },
      "station-led-on":   { "$type": "color", "$value": "#e2ddd5" },
      "station-led-ok":   { "$type": "color", "$value": "#9dbb91" },
      "station-led-attn": { "$type": "color", "$value": "#e8905a" },
      "station-canary":   { "$type": "color", "$value": "#d8b758" }
    }
  },

  "font": {
    "display": { "$type": "fontFamily", "$value": ["Instrument Serif", "Georgia", "serif"], "$description": "Headlines, stage and panel names, big numbers in prose. Regular and italic only." },
    "sans":    { "$type": "fontFamily", "$value": ["Geist", "system-ui", "sans-serif"], "$description": "Body, controls, captions." },
    "mono":    { "$type": "fontFamily", "$value": ["Geist Mono", "ui-monospace", "Menlo", "monospace"], "$description": "Labels, ids, clocks, figures. Anything that reads like a log." }
  },

  "type": {
    "$description": "Sizes in px at the 1440 desktop layout. Tracking in px.",
    "display":  { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "58px", "lineHeight": 1,    "letterSpacing": "-1px" } },
    "title":    { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "32px", "lineHeight": 1.05, "letterSpacing": "-0.1px" } },
    "heading":  { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "26px", "lineHeight": 1,    "letterSpacing": "-0.1px" } },
    "stage":    { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "23px", "lineHeight": 1.1,  "letterSpacing": "-0.1px" } },
    "subtitle": { "$type": "typography", "$value": { "fontFamily": "{font.display}", "fontSize": "22px", "lineHeight": 1.2,  "fontStyle": "italic" } },
    "body":     { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "15px", "lineHeight": 1.4,  "letterSpacing": "-0.1px" } },
    "ui":       { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "13px", "lineHeight": 1.4,  "letterSpacing": "-0.1px" } },
    "caption":  { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontSize": "12px", "lineHeight": 1.45 } },
    "figure":   { "$type": "typography", "$value": { "fontFamily": "{font.mono}", "fontSize": "28px", "lineHeight": 1.2,  "letterSpacing": "-0.5px", "fontVariantNumeric": "tabular-nums" } },
    "clock":    { "$type": "typography", "$value": { "fontFamily": "{font.mono}", "fontSize": "24px", "lineHeight": 1.2,  "fontVariantNumeric": "tabular-nums" } },
    "data":     { "$type": "typography", "$value": { "fontFamily": "{font.mono}", "fontSize": "11px", "lineHeight": 1.4 } },
    "label":    { "$type": "typography", "$value": { "fontFamily": "{font.mono}", "fontSize": "10.5px", "lineHeight": 1.4, "letterSpacing": "1.2px", "textTransform": "uppercase" } }
  },

  "space": {
    "$description": "Spacing is written in pixels, on a 4px base; only the page's gutter is a token.",
    "gutter": { "$type": "dimension", "$value": "48px", "$description": "The page margin at desktop." }
  },

  "radius": {
    "$description": "Flat, small radii. Cards 6, panels 8, pills fully round.",
    "rule":  { "$type": "dimension", "$value": "2px", "$description": "The squared edge of a Needs-you card, where the attn rule sits." },
    "small": { "$type": "dimension", "$value": "4px" },
    "card":  { "$type": "dimension", "$value": "6px" },
    "panel": { "$type": "dimension", "$value": "8px" },
    "pill":  { "$type": "dimension", "$value": "999px" }
  },

  "stroke": {
    "hairline": { "$type": "dimension", "$value": "1px", "$description": "Borders and dividers." },
    "rule":     { "$type": "dimension", "$value": "2px", "$description": "The Needs-you rule; focus outlines; station chassis outline." },
    "detail":   { "$type": "dimension", "$value": "1.75px", "$description": "Station tools and linework." }
  },

  "shadow": {
    "popover": { "$type": "shadow", "$value": { "color": "#201c1429", "offsetX": "0px", "offsetY": "18px", "blur": "48px", "spread": "0px" }, "$description": "The only elevation: popovers over the line, and the sheet over the page." }
  },

  "motion": {
    "$description": "Every animation stops under prefers-reduced-motion and when the console's motion switch is off; the still pose must carry the same meaning.",
    "flow":     { "$type": "duration", "$value": "1100ms", "$description": "Dashed flow on connectors." },
    "belt":     { "$type": "duration", "$value": "700ms",  "$description": "One chevron of belt travel while working; passing runs at 1400ms." },
    "beacon":   { "$type": "duration", "$value": "2000ms", "$description": "Calm beacon glow." },
    "alarm":    { "$type": "duration", "$value": "900ms",  "$description": "Beacon flash when a station needs you. Stays under 3 flashes a second (WCAG 2.3.1)." },
    "blink":    { "$type": "duration", "$value": "2000ms", "$description": "Live dots." },
    "ease":     { "$type": "cubicBezier", "$value": [0.45, 0, 0.55, 1] }
  },

  "station": {
    "$description": "Geometry of the station illustration. Drawn in a 168 x 220 box so eight stations make one 1344px conveyor.",
    "width":  { "$type": "dimension", "$value": "168px" },
    "height": { "$type": "dimension", "$value": "220px" },
    "belt-top": { "$type": "dimension", "$value": "186px", "$description": "Top of the belt from the top of the box; parcels sit here." }
  }
}
